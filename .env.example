# Optional server configuration. No credentials are needed for the offline demo.
# Set these in your shell before npm start; .env files are not loaded automatically.
TELEMETRY_API_KEY=
SIGNAL_MCP_URL=
SIGNAL_MCP_TOKEN=
# Set to your Python executable if python is not on PATH.
SIGNAL_PYTHON=python
# Optional model-assisted mode only; see agents/model_agents.py for SDK credentials.
SIGNAL_AGENT_MODEL=

# External tool execution is disabled unless explicitly enabled.
SIGNAL_ALLOW_EXTERNAL_EXECUTION=false
SIGNAL_MCP_ALLOWED_TOOLS=[]
# Optional live roster mapping; never guess team membership.
SIGNAL_TEAM_MAPPING=[]
